# Frontend: public API base only. Never put database credentials in VITE_*.
VITE_API_BASE_URL=http://localhost:8080
# Optional account sign-in. Production serves this through a same-origin rewrite.
VITE_AUTH_URL=/auth
# Actual Neon Auth branch endpoint, used only by the API for JWT verification.
NEON_AUTH_URL=https://YOUR_NEON_AUTH_HOST/ghostdesk/auth
# API: JDBC URL contains host/database/SSL settings only, no credentials.
JDBC_DATABASE_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
DB_USERNAME=ghostdesk_app
DB_PASSWORD=
ALLOWED_ORIGINS=http://localhost:4173
